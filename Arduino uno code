
#include <SoftwareSerial.h>
#include <DFRobotDFPlayerMini.h>

SoftwareSerial mySerial(10, 11); 
// Arduino D10 = DFPlayer TX
// Arduino D11 = DFPlayer RX

DFRobotDFPlayerMini player;

void setup() {
  mySerial.begin(9600);
  Serial.begin(9600);

  Serial.println("LBX TECH LAB");
  Serial.println("Starting Speaking System...");

  if (!player.begin(mySerial)) {
    Serial.println("DFPlayer not detected!");
    while (true) {
      delay(100);
    }
  }

  player.volume(25);  // Volume: 0 to 30
  delay(1000);

  player.play(1);     // Plays /MP3/0001.mp3
}

void loop() {
  // Audio plays automatically after startup
}
